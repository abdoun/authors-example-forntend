server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Runtime config must never be cached by browsers or reverse proxies.
    location = /env.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # Same-origin path to the authors backend. nginx resolves the Docker
    # container name over the embedded DNS, so the browser never has to.
    location /api/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $authors_upstream "${AUTHORS_BACKEND_URL}";
        proxy_pass $authors_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Same-origin path to the auth backend. The /auth prefix is stripped so
    # /auth/login becomes /login on the upstream service.
    location /auth/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $auth_upstream "${AUTH_BACKEND_URL}";
        rewrite ^/auth/?(.*)$ /$1 break;
        proxy_pass $auth_upstream$uri$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Browsers send Origin on POST even for same-origin requests. The auth
        # backend rejects unknown origins, and this proxy needs no CORS.
        proxy_set_header Origin "";
    }

    # Client-side routing: let React Router handle unknown paths.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
