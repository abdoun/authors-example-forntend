# Only this setting is required.
FRONTEND_PORT=8088

# Optional. nginx needs an address it can reach for each backend. By default
# it uses the Docker container names on the shared networks:
#   authors backend: http://authors-api:80
#   auth backend:    http://user-auth-api:3000
#
# These are not browser addresses. You can point them at any address the
# SERVER can reach: a Docker name, a home-LAN IP, a Tailscale IP, or a public
# host, e.g.:
#   AUTHORS_BACKEND_URL=http://100.x.y.z:8087
#   AUTH_BACKEND_URL=http://100.x.y.z:3002
#
# The browser always calls same-origin /api/* and /auth/* on port 8088, so
# no CORS configuration is needed on the backends.

# AUTHORS_BACKEND_URL=http://authors-api:80
# AUTH_BACKEND_URL=http://user-auth-api:3000

# Advanced: browser-facing paths (defaults are /api and /auth).
# AUTHORS_API_URL=/api
# AUTH_API_URL=/auth

# Base URL of the user-auth-react frontend. It owns login, logout, register
# and profile. The "Account" link goes to <USER_AUTH_URL>/profile when signed
# in, otherwise <USER_AUTH_URL>/login. Derived from the current host when
# unset: http://<host>:8083 for IP/localhost, auth.<domain> for a domain.
# USER_AUTH_URL=https://auth.abdullah-alaswad.link

# Optional override for the "Register" link if it is not <USER_AUTH_URL>/register.
# USER_AUTH_REGISTER_URL=https://auth.abdullah-alaswad.link/register
