# Host port that publishes the frontend container (HOST:CONTAINER).
FRONTEND_PORT=8088

# Browser-facing auth API base URL. Login POSTs to <AUTH_API_URL>/login.
# Use a URL reachable from the client, with the same scheme as this page.
# Examples:
#   http://100.77.129.7:3002          (Tailscale / LAN IP)
#   https://auth-api.example.com      (reverse proxy with TLS)
AUTH_API_URL=http://100.77.129.7:3002

# Browser-facing authors API base URL, including its /api prefix.
# The Authors page fetches <AUTHORS_API_URL>/authors.
# Examples:
#   http://100.77.129.7:8087/api
#   https://authors-api.example.com/api
AUTHORS_API_URL=http://100.77.129.7:8087/api

# Optional: where the "Register" link points. If unset, IP/localhost visits
# use http://<same-host>:8083/register and authors-example.<domain> visitors
# use auth.<domain>/register.
# USER_AUTH_REGISTER_URL=https://auth.abdullah-alaswad.link/register
