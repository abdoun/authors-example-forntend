# Host port that publishes the frontend container (HOST:CONTAINER).
FRONTEND_PORT=8088

# Authors backend as seen from inside the Docker network. nginx uses this
# address to proxy /api/* requests; it is NOT resolved by the browser.
AUTHORS_BACKEND_URL=http://authors-example-backend:8078

# Authors API base URL used by the browser. "/api" goes through the nginx
# proxy above (recommended). To call the backend directly instead, use a
# browser-resolvable URL ending in /api, e.g. http://<server-ip>:8078/api
AUTHORS_API_URL=/api

# Auth backend base URL used by the browser for POST /login. This is a
# separate service; it must be reachable from the client (and allow CORS).
# Example: http://<server-ip>:3001
AUTH_API_URL=http://localhost:3000
